<!DOCTYPE html>
<html lang="es">
<%- include('includes/head') %>
<body>
    <%- include('includes/navbar') %>

    <h1>Login</h1>
    <form action="/login" method="POST">
        <label for="username">Usuario:</label>
        <input type="text" id="username" name="username" required>

